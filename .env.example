# ==============================================================================
# CyberShield XDR — Unified Environment Variables Template
# ==============================================================================
# Copy this file to .env in your respective service directories or define them
# in your hosting provider's dashboard (e.g., Vercel, Render, Railway).
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL for the backend API.
# Leave blank or set to '/api' if deployed together under the same Vercel domain.
# For local development with backend running on port 8000, use: http://127.0.0.1:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL Database URL
# In local development, the app will fall back to SQLite if DATABASE_URL is not set.
# Example PostgreSQL string: postgresql://username:password@hostname:5432/database_name
# Note: Vercel serverless functions require a managed PostgreSQL instance to persist data.
DATABASE_URL=postgresql://postgres:postgres_secure_pass_123@localhost:5432/cybershield

# JWT Security Settings
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=your_generated_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Administrator Seeding Credentials
# The platform will dynamically create this admin account during first startup.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cybershield.local
ADMIN_PASSWORD=your_secure_admin_password_here

# Secure CORS allowed origins (comma-separated URLs)
# Restrict this to your production domain(s) in production.
# Example: https://cybershield-xdr.vercel.app
ALLOWED_ORIGINS=*
