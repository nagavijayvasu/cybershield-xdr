# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_123
POSTGRES_DB=cybershield
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URL
DATABASE_URL=postgresql://postgres:postgres_secure_pass_123@localhost:5432/cybershield

# JWT Security Settings
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=your_generated_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Administrator Seeding Credentials
# Provide variables below. On next application start, the platform will auto-create this admin user.
ADMIN_USERNAME=your_admin_username_here
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_secure_admin_password_here
